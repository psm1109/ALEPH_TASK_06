{
  "contract_id": "pds-schema-v2",
  "title": "PDS Diary 데이터 계약 v2",
  "version": "2.3.0",
  "workspace": {
    "mode": "authenticated-per-user-workspace",
    "workspace_id": "pds-main",
    "authentication": "Supabase Auth email/password",
    "ownership": "Every row user_id must equal auth.uid().",
    "unauthenticated_access": "denied"
  },
  "date_rules": {
    "timezone": "Asia/Seoul",
    "date": "YYYY-MM-DD 형식의 달력 날짜이며 시간대 변환을 하지 않는다.",
    "timestamp": "RFC 3339 형식으로 저장하고 화면 표시와 날짜별 집계에는 Asia/Seoul을 적용한다.",
    "today": "화면의 완료 상태는 Asia/Seoul 날짜별 실행 기록을 따른다. 같은 할 일에 실행 기록이 하나 이상 있으면 해당 날짜 완료 1건으로 계산하며 완료 체크는 직접 조작하지 않는다. 지난 날짜별 미완료 기록은 할 일을 만든 날과 마감일 중 늦은 날부터 어제까지, 해당 날짜에 실행 기록이 없는 경우에 저장한다.",
    "duration": "실행 시간은 end_time과 start_time 차이를 반올림한 양의 정수 분으로 저장한다."
  },
  "units": {
    "plan_versions.expected_days": "day",
    "tasks.estimated_minutes": "minute",
    "task_execution_logs.actual_minutes": "minute"
  },
  "tables": {
    "plan_versions": {
      "description": "수정할 때 기존 행을 덮어쓰지 않는 계획 버전",
      "primary_key": "id",
      "unique": [["user_id", "workspace_id", "version"]],
      "fields": {
        "id": { "type": "integer", "generated": true },
        "user_id": { "type": "uuid", "required": true, "default": "auth.uid()" },
        "workspace_id": { "type": "string", "required": true },
        "version": { "type": "integer", "required": true, "minimum": 1 },
        "title": { "type": "string", "required": true },
        "start_date": { "type": "date", "required": true },
        "end_date": { "type": "date", "required": true },
        "priority": { "type": "enum", "values": ["high", "medium", "low"], "required": true },
        "success_criteria": { "type": "string", "required": true },
        "expected_days": { "type": "integer", "unit": "day", "minimum": 1, "required": true },
        "carryover_note": { "type": "string", "required": true, "default": "" },
        "created_at": { "type": "timestamp", "required": true, "generated": true }
      }
    },
    "tasks": {
      "description": "계획 버전에 딸린 할 일",
      "primary_key": "id",
      "unique": [["user_id", "workspace_id", "seed_key"]],
      "fields": {
        "id": { "type": "integer", "generated": true },
        "user_id": { "type": "uuid", "required": true, "default": "auth.uid()" },
        "workspace_id": { "type": "string", "required": true },
        "plan_version": { "type": "integer", "required": true },
        "seed_key": { "type": ["string", "null"] },
        "title": { "type": "string", "required": true },
        "due_date": { "type": "date", "required": true },
        "priority": { "type": "enum", "values": ["high", "medium", "low"], "required": true },
        "tags": { "type": "array", "items": "string", "required": true, "default": [] },
        "estimated_minutes": { "type": "integer", "unit": "minute", "minimum": 1, "required": true },
        "is_completed": { "type": "boolean", "required": true, "default": false },
        "completed_at": { "type": ["timestamp", "null"] },
        "created_at": { "type": "timestamp", "required": true, "generated": true },
        "updated_at": { "type": "timestamp", "required": true, "generated": true }
      }
    },
    "task_execution_logs": {
      "description": "할 일에 연결되는 실제 실행 기록",
      "primary_key": "id",
      "fields": {
        "id": { "type": "integer", "generated": true },
        "user_id": { "type": "uuid", "required": true, "default": "auth.uid()" },
        "workspace_id": { "type": "string", "required": true },
        "task_id": { "type": "integer", "required": true },
        "start_time": { "type": "timestamp", "required": true },
        "end_time": { "type": "timestamp", "required": true, "constraint": "end_time > start_time" },
        "actual_minutes": { "type": "integer", "unit": "minute", "minimum": 1, "required": true },
        "blocker_reason": { "type": "string", "required": true, "default": "" },
        "created_at": { "type": "timestamp", "required": true, "generated": true }
      }
    },
    "task_completion_events": {
      "description": "이전 완료 체크 방식의 호환과 내보내기를 위해 유지하는 기록. 현재 화면의 완료 상태와 완료 수는 task_execution_logs에서 계산",
      "primary_key": "id",
      "unique": [["user_id", "task_id", "completed_day"]],
      "fields": {
        "id": { "type": "integer", "generated": true },
        "user_id": { "type": "uuid", "required": true, "default": "auth.uid()" },
        "workspace_id": { "type": "string", "required": true },
        "task_id": { "type": "integer", "required": true },
        "completed_at": { "type": "timestamp", "required": true, "generated": true },
        "completed_day": { "type": "date", "required": true, "timezone": "Asia/Seoul", "derived_from": "completed_at" }
      }
    },
    "task_missed_days": {
      "description": "지난 서울 날짜마다 완료하지 못한 할 일의 영구 기록. 이후 완료해도 보존되며 할 일을 삭제하면 함께 삭제된다.",
      "primary_key": "id",
      "unique": [["user_id", "task_id", "missed_day"]],
      "fields": {
        "id": { "type": "integer", "generated": true },
        "user_id": { "type": "uuid", "required": true, "default": "auth.uid()" },
        "workspace_id": { "type": "string", "required": true },
        "task_id": { "type": "integer", "required": true },
        "missed_day": { "type": "date", "required": true, "timezone": "Asia/Seoul" },
        "task_title": { "type": "string", "required": true },
        "due_date": { "type": "date", "required": true },
        "created_at": { "type": "timestamp", "required": true, "generated": true }
      }
    },
    "reflections": {
      "description": "계획 버전에 연결되며 작성 후 수정하거나 삭제할 수 있는 돌아보기 기록",
      "primary_key": "id",
      "mutability": {
        "insert": true,
        "update": ["reflection_date", "mood", "went_well", "next_action", "updated_at"],
        "delete": "hard-delete"
      },
      "fields": {
        "id": { "type": "integer", "generated": true },
        "user_id": { "type": "uuid", "required": true, "default": "auth.uid()" },
        "workspace_id": { "type": "string", "required": true },
        "plan_version": { "type": "integer", "required": true },
        "reflection_date": { "type": "date", "required": true },
        "mood": { "type": "enum", "values": ["great", "good", "okay", "hard"], "required": true },
        "went_well": { "type": "string", "required": true },
        "next_action": { "type": "string", "required": true },
        "created_at": { "type": "timestamp", "required": true, "generated": true },
        "updated_at": { "type": "timestamp", "required": true, "default": "now()", "updated_by": "application" }
      }
    }
  },
  "relationships": [
    {
      "from": "tasks.(workspace_id, plan_version)",
      "to": "plan_versions.(workspace_id, version)",
      "cardinality": "many-to-one",
      "enforcement": "application"
    },
    {
      "from": "reflections.(workspace_id, plan_version)",
      "to": "plan_versions.(workspace_id, version)",
      "cardinality": "many-to-one",
      "enforcement": "application"
    },
    {
      "from": "task_execution_logs.task_id",
      "to": "tasks.id",
      "cardinality": "many-to-one",
      "on_delete": "cascade",
      "enforcement": "database"
    },
    {
      "from": "task_completion_events.task_id",
      "to": "tasks.id",
      "cardinality": "many-to-one",
      "on_delete": "cascade",
      "enforcement": "database"
    },
    {
      "from": "task_missed_days.task_id",
      "to": "tasks.id",
      "cardinality": "many-to-one",
      "on_delete": "cascade",
      "enforcement": "database"
    }
  ],
  "export": {
    "format": "pds-diary-export",
    "media_type": "application/json",
    "top_level_fields": ["format", "schema_version", "exported_at", "workspace_id", "timezone", "units", "data"],
    "data_collections": ["plan_versions", "tasks", "task_execution_logs", "task_completion_events", "task_missed_days", "reflections"],
    "excludes": ["Supabase URL", "publishable key", "secret key", "authorization headers"]
  },
  "security": {
    "authentication_service": "Supabase Auth",
    "client_library": "@supabase/supabase-js 2.116.0",
    "password_hashing": "bcrypt with a randomly generated salt per password, managed by Supabase Auth",
    "password_storage": "Only auth.users.encrypted_password is stored by Supabase Auth; plaintext is not stored in diary tables.",
    "password_transport": "The browser sends only RSA-OAEP-256 wrapped AES-256-GCM ciphertext to the auth-gateway Edge Function; plaintext password fields are not included in browser network payloads.",
    "password_logging": "The app and auth-gateway do not log passwords or raw authentication request and response bodies; upstream authentication errors are replaced with generic responses.",
    "authorization": "PostgreSQL RLS requires authenticated and user_id = auth.uid().",
    "access_token_transport": "Authorization header only; never URL query parameters.",
    "rendering": "사용자 입력은 textContent 또는 HTML 이스케이프 후 표시한다.",
    "browser_allowed_key_prefix": "sb_publishable_",
    "forbidden_secret_markers": ["service_role", "sb_secret_", "SUPABASE_SERVICE_ROLE_KEY", "JWT_SECRET"]
  }
}
